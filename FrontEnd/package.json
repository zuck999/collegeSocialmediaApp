{
  "name": "app",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "husky install",
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "serve": "vite preview",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "biome check",
    "deploy": "wrangler deploy"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md}": [
      "biome format --write",
      "biome check --quiet",
      "git add"
    ]
  },
